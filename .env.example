# Set the real values in Render Environment Variables.
APP_ENV=production
APP_NAME=OJTSync
APP_URL=https://your-render-service.onrender.com
# Leave empty for one Render instance; configure a shared session store before scaling.
SESSION_SAVE_PATH=

DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASS=your-mysql-password
DB_NAME=ojt_dtr
DB_PORT=3306
DB_CHARSET=utf8mb4
# Optional path to the provider CA certificate. Required for strict certificate verification.
DB_SSL_CA=

MAIL_FROM=your-sender@example.com
MAIL_FROM_NAME=OJTSync
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=your-sender@example.com
SMTP_PASS=your-gmail-app-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=ojtsync/export-logos
